<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ComputerUI/USS/ComputerUI.uss?fileID=7433441132597879392&amp;guid=47154671972eb2c4eaf42f63d940c852&amp;type=3#ComputerUI"/>
    <ui:VisualElement name="WorkAppViewRoot" class="work-app-view-root" style="background-color: rgb(191, 191, 191); padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; height: 100%;">
        <ui:VisualElement name="WorkHeader" style="flex-grow: 0; height: 100px; background-color: rgb(255, 255, 255); border-bottom-width: 1px; border-bottom-color: rgb(221, 221, 221); flex-direction: row; align-items: center; justify-content: space-between; margin-left: 12px; margin-right: 12px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
            <ui:Label text="Bao Ơ Boi&#10;" name="WorkTitleLabel" style="font-size: 30px;"/>
            <ui:Label name="WorkProgressLabel" text="1/2" class="work-progress" style="color: rgb(55, 55, 55); height: auto; border-bottom-width: 1px; border-bottom-color: rgb(221, 221, 221); background-color: rgb(101, 169, 239); font-size: 30px; -unity-text-align: middle-center; margin-bottom: 8px; -unity-background-image-tint-color: rgb(255, 255, 255); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-right: 14px; width: 72px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="WorkAppBody" enabled="true" class="work-app-body" style="height: 70%; display: flex; margin-top: 25px; margin-bottom: 15px;">
            <ui:VisualElement name="QuizPanel" class="work-quiz-panel" style="margin-top: 16px; height: 100%; display: none;">
                <ui:Label name="WorkQuestionLabel" text="Câu hỏi..." class="work-question" style="font-size: 40%; color: rgb(34, 34, 34); padding-bottom: 12px; -unity-font-style: bold; margin-left: 12px; margin-bottom: 84px;"/>
                <ui:VisualElement name="WorkOptions" class="work-options" style="width: 60%; align-items: stretch; justify-content: flex-start; align-self: flex-start; height: 60%;">
                    <ui:Button name="WorkOptionA" text="A" class="work-option-button" style="height: 30%; margin-bottom: 8px; margin-left: 12px; color: rgb(34, 34, 34); -unity-text-align: middle-left; font-size: 30px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;"/>
                    <ui:Button name="WorkOptionB" text="B" class="work-option-button" style="-unity-text-align: middle-left; height: 30%; color: rgb(34, 34, 34); margin-bottom: 8px; margin-left: 12px; font-size: 30px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;"/>
                    <ui:Button name="WorkOptionC" text="C" class="work-option-button" style="-unity-text-align: middle-left; color: rgb(34, 34, 34); margin-bottom: 8px; margin-left: 12px; height: 30%; font-size: 30px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;"/>
                </ui:VisualElement>
                <ui:Label name="WorkQuizStatusLabel" text="" class="work-status"/>
            </ui:VisualElement>
            <ui:VisualElement name="ArrangePanel" enabled="true" class="work-arrange-panel" style="display: flex; background-color: rgb(255, 255, 255); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; border-left-color: rgb(221, 221, 221); border-right-color: rgb(221, 221, 221); border-top-color: rgb(221, 221, 221); border-bottom-color: rgb(221, 221, 221); border-top-width: 1px; margin-left: 12px; height: 100%; align-items: center;">
                <ui:Label text="Sắp xếp báo cáo" name="Label" class="work-step-title" style="font-size: 30px;"/>
                <ui:VisualElement name="WorkArrangeList" class="work-arrange-list" style="height: 90%; background-color: rgb(249, 250, 252); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(221, 221, 221); border-right-color: rgb(221, 221, 221); border-top-color: rgb(221, 221, 221); border-bottom-color: rgb(221, 221, 221); font-size: 40px; width: 100%; align-self: center;">
                    <ui:VisualElement name="DropSlotsContainer" class="work-drop-slots" style="flex-direction: row; justify-content: space-between;"/>
                    <ui:VisualElement name="AnswerPoolContainer" class="work-answer-pool" style="flex-direction: row; justify-content: space-between;"/>
                </ui:VisualElement>
                <ui:Label name="WorkArrangeStatusLabel" text="" class="work-status" style="height: 34px; -unity-font-style: bold; font-size: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WorkAppFooter" class="work-app-footer" style="flex-direction: row; justify-content: space-between; align-items: center; align-self: center; width: 100%; height: 15%;">
            <ui:Button name="WorkNextButton" text="Tiếp tục" class="work-primary-button" style="width: 30%; height: 60%; font-size: 50px; background-color: rgb(0, 140, 220); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
            <ui:Button name="CompleteWorkButton" text="Hoàn thành công việc" class="complete-button" style="width: 30%; height: 60%; font-size: 30px; background-color: rgb(58, 212, 29); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
            <ui:Button name="CloseWorkButton" text="Đóng" class="work-close-button" style="width: 30%; height: 60%; font-size: 50px; background-color: rgb(218, 0, 0); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
