/* Nút Start = hình tròn rỗng (chỉ viền, không nền); đỏ khi có thể tắt */
.start-button {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    border-radius: 50%;
    background-color: transparent;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(180, 180, 180, 0.9);
    border-right-color: rgba(180, 180, 180, 0.9);
    border-top-color: rgba(180, 180, 180, 0.9);
    border-bottom-color: rgba(180, 180, 180, 0.9);
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-left: 12px;
}

.start-button.start-button-can-close {
    border-left-color: rgba(230, 51, 51, 0.95);
    border-right-color: rgba(230, 51, 51, 0.95);
    border-top-color: rgba(230, 51, 51, 0.95);
    border-bottom-color: rgba(230, 51, 51, 0.95);
}

.start-button-label {
    font-size: 0;
    width: 0;
    height: 0;
    overflow: hidden;
}

/* Taskbar App Icons */
.taskbar-app-icon {
    cursor: link;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    width: auto;
    height: 60px;
    background-color: rgba(48, 48, 48, 0.8);
    margin-right: 5px;
    padding: 0 15px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.taskbar-icon-label {
    font-size: 30px;
    color: white;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.work-drop-slot {
    background-color: #f9fafc;
    border: 2px dashed #4c7dff;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 8px;
}

.work-drop-slot-title {
    font-size: 24px;
    font-weight: bold;
    color: #4c7dff;
    margin-bottom: 8px;
}

.work-drop-slot-box {
    min-height: 180px;
    background-color: #ffffff;
    border-radius: 6px;
    padding: 12px;
}
.work-drop-slot-hover {
    background-color: #eef3ff;
}
.work-answer-card {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding: 14px;
    width: 30%;
}

.work-answer-card:hover {
    background-color: #eef3ff;
}
.work-answer-text {
    font-size: 24px;
    color: #222222;
}
.work-answer-ghost {
    opacity: 0.7;
}
/* ===== WorkApp LIGHT MODE OVERRIDE ===== */

.work-app-view-root {
    background-color: #f4f6f8;
}

.work-app-body {
    background-color: #f4f6f8;
}
.work-app-header {
    background-color: #ffffff;
    border-bottom-color: #dddddd;
}

.work-app-title {
    color: #222222;
}

.work-progress {
    color: #666666;
}
.work-step-title {
    color: #222222;
}

.work-question {
    color: #222222;
}
.work-option-button {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #dddddd;
}

.work-option-button:hover {
    background-color: #eef3ff;
}

.work-option-selected {
    background-color: #dbe7ff;
    border-color: #4c7dff;
}
.work-status {
    color: #cc6600;
}

.work-hint {
    color: #666666;
}
.work-app-footer {
    background-color: #ffffff;
    border-top-color: #dddddd;
}

.work-primary-button {
    background-color: #4a7cff;
}

.work-primary-button:disabled {
    background-color: #cccccc;
    color: #888888;
}

.work-close-button {
    background-color: #ff4444;
}