/* Chat Styles - Message Bubbles */

.message-left {
    align-self: flex-start;
    background-color: #2a2a2a;
    color: white;
    padding: 18px 22px;
    margin-bottom: 12px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
}

.message-right {
    align-self: flex-end;
    background-color: #4a7cff;
    color: white;
    padding: 18px 22px;
    margin-bottom: 12px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
}

.highlight {
    background-color: #444;
}

/* ===== Chat list hover/selected (MessageApp) ===== */
/* Áp dụng cho 2 item: ChatListItem_Mom, ChatListItem_Boss (class="chat-list-item") */
.chat-list-item {
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.chat-list-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* Khi đang selected thì hover sáng hơn một chút nhưng vẫn giữ cảm giác selected */
.chat-list-item.chat-list-item-selected {
    background-color: rgba(74, 124, 255, 0.25);
}

.chat-list-item.chat-list-item-selected:hover {
    background-color: rgba(74, 124, 255, 0.32);
}

/* Tăng cỡ chữ trong message bubbles */
.message-left Label,
.message-right Label {
    font-size: 40px;
    white-space: normal;
}
